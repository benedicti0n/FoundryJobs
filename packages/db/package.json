{
  "name": "@foundryjobs/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:sources": "tsx src/seed/sources.ts",
    "test:db:setup": "tsx scripts/setup-test-db.ts",
    "typecheck": "tsc --noEmit",
    "sources:sync": "tsx scripts/sync-sources.ts",
    "companies:sync-logos": "tsx scripts/sync-company-logos.ts"
  },
  "dependencies": {
    "@foundryjobs/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
