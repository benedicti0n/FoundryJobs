{
  "name": "foundryjobs",
  "version": "0.0.0",
  "private": true,
  "description": "Hiring-post fetcher and social-post generator for fresher, intern, and 0-3 YOE tech roles.",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @foundryjobs/web dev",
    "dev:api": "pnpm --filter @foundryjobs/api dev",
    "dev:worker": "pnpm --filter @foundryjobs/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "start:web": "pnpm --filter @foundryjobs/web start",
    "start:api": "pnpm --filter @foundryjobs/api start",
    "start:worker": "pnpm --filter @foundryjobs/worker start",
    "start:scheduler": "pnpm --filter @foundryjobs/worker start:scheduler",
    "check:env": "pnpm --filter @foundryjobs/worker check-env",
    "test": "pnpm test:db:setup && pnpm test:unit",
    "test:db:setup": "pnpm --filter @foundryjobs/db test:db:setup",
    "test:unit": "node --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\" \"packages/*/tests/**/*.test.ts\"",
    "test:telegram-publish": "pnpm --filter @foundryjobs/worker test:telegram-publish",
    "test:r2-upload": "pnpm --filter @foundryjobs/worker test:r2-upload",
    "test:buffer-publish": "pnpm --filter @foundryjobs/worker test:buffer-publish",
    "db:generate": "pnpm --filter @foundryjobs/db db:generate",
    "db:migrate": "pnpm --filter @foundryjobs/db db:migrate",
    "db:studio": "pnpm --filter @foundryjobs/db db:studio",
    "db:seed:sources": "pnpm --filter @foundryjobs/db seed:sources",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sources:sync": "pnpm --filter @foundryjobs/db sources:sync",
    "sources:verify": "pnpm --filter @foundryjobs/fetchers sources:verify",
    "jobs:select": "pnpm --filter @foundryjobs/selection select:preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@foundryjobs/buffer": "workspace:*",
    "@foundryjobs/buffer-publisher": "workspace:*",
    "@foundryjobs/db": "workspace:*",
    "@foundryjobs/post-generator": "workspace:*",
    "@foundryjobs/publisher": "workspace:*",
    "@foundryjobs/shared": "workspace:*",
    "@foundryjobs/telegram": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
