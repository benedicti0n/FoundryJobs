{
  "name": "@foundryjobs/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "fetch:once": "tsx src/index.ts fetch:once",
    "normalize:once": "tsx src/index.ts normalize:once",
    "generate-posts:once": "tsx src/index.ts generate-posts:once",
    "publish-telegram:once": "tsx src/index.ts publish-telegram:once",
    "render-instagram-cards:once": "tsx src/index.ts render-instagram-cards:once",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foundryjobs/card-renderer": "workspace:*",
    "@foundryjobs/db": "workspace:*",
    "@foundryjobs/fetchers": "workspace:*",
    "@foundryjobs/normalizer": "workspace:*",
    "@foundryjobs/post-generator": "workspace:*",
    "@foundryjobs/publisher": "workspace:*",
    "@foundryjobs/shared": "workspace:*",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
